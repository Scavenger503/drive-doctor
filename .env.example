# Copy to .env and fill in. Never commit .env.
DD_AI_BASE_URL=https://api.tokenlab.amd.com/v1
DD_AI_API_KEY=your-token-lab-key
DD_AI_MODEL=DeepSeek-V4-Flash
# Tried once if the main model fails or times out ("none" to disable).
DD_AI_BACKUP_MODEL=Gemma-4-31B-IT
# AI explanations per visitor per day (0 = unlimited). The verdict always works.
DD_DAILY_LIMIT=30
